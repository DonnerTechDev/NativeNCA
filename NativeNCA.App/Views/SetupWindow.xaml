<ui:FluentWindow x:Class="NativeNCA.App.Views.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Установка NativeNCA"
        Icon="pack://application:,,,/NativeNCA;component/Assets/app.ico"
        Width="520"
        SizeToContent="Height"
        MinHeight="0"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        ExtendsContentIntoTitleBar="True">

    <ui:FluentWindow.Resources>
        <!-- One "icon | title + text" point, as in the certificate dialog -->
        <Style x:Key="PointIcon" TargetType="ui:SymbolIcon">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Margin" Value="0,1,14,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="NoteBorder" TargetType="Border">
            <Setter Property="Margin" Value="0,20,0,0" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="NativeNCA" ShowMinimize="False" ShowMaximize="False" CanMaximize="False">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="ShieldKeyhole24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <StackPanel Grid.Row="1" Margin="24,4,24,24">

            <!-- ============ Header ============ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image x:Name="AppIconImage" Width="56" Height="56" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="HeaderSubtitle" Margin="0,2,0,0" FontSize="13" TextWrapping="Wrap"
                               Style="{StaticResource SecondaryText}" />
                </StackPanel>
            </Grid>

            <!-- ============ Install ============ -->
            <StackPanel x:Name="InstallContent" Margin="0,24,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="Person24" Style="{StaticResource PointIcon}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Для вашей учётной записи" FontWeight="SemiBold" Style="{StaticResource PrimaryText}" />
                        <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" FontSize="13" Style="{StaticResource SecondaryText}"
                                   Text="Права администратора не нужны. NativeNCA появится в меню «Пуск» и в списке установленных приложений Windows." />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="ArrowSync24" Style="{StaticResource PointIcon}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Обновляется сам" FontWeight="SemiBold" Style="{StaticResource PrimaryText}" />
                        <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" FontSize="13" Style="{StaticResource SecondaryText}"
                                   Text="Новые версии приходят с GitHub и устанавливаются, только если подписаны разработчиком. Предыдущую версию можно вернуть в параметрах." />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="ShieldLock24" Style="{StaticResource PointIcon}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Ключи остаются на месте" FontWeight="SemiBold" Style="{StaticResource PrimaryText}" />
                        <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" FontSize="13" Style="{StaticResource SecondaryText}"
                                   Text="Хранилище ключей и параметры лежат в вашем профиле Windows. Установка и обновления их не меняют." />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- ============ Uninstall ============ -->
            <StackPanel x:Name="UninstallContent" Margin="0,20,0,0" Visibility="Collapsed">
                <TextBlock TextWrapping="Wrap" FontSize="13" Style="{StaticResource SecondaryText}"
                           Text="NativeNCA будет закрыт, а программа, ярлык в меню «Пуск» и автозапуск — удалены. Сайты перестанут видеть NativeNCA, пока вы не установите его снова или не запустите NCALayer." />

                <Border Margin="0,20,0,0" Padding="16,12" CornerRadius="8" BorderThickness="1"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <StackPanel>
                        <CheckBox x:Name="RemoveDataCheckBox" Content="Также удалить ключи и сертификат для браузеров" />
                        <TextBlock Margin="39,4,0,0" TextWrapping="Wrap" FontSize="12" Style="{StaticResource SecondaryText}"
                                   Text="Зашифрованные копии ключей, сохранённые пароли и параметры будут удалены, а корневой сертификат NativeNCA — убран из Windows. Исходные файлы .p12 на диске не затрагиваются. Если не отмечать, всё сохранится до следующей установки." />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Installed version, warnings after uninstall -->
            <Border x:Name="InfoNote" Style="{StaticResource NoteBorder}"
                    Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="Info24" Filled="True" FontSize="16" Margin="0,1,10,0" VerticalAlignment="Top"
                                   Foreground="{DynamicResource SystemFillColorAttentionBrush}" />
                    <TextBlock x:Name="InfoText" Grid.Column="1" TextWrapping="Wrap" FontSize="13" Style="{StaticResource PrimaryText}" />
                </Grid>
            </Border>

            <Border x:Name="ErrorNote" Style="{StaticResource NoteBorder}"
                    Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="ErrorCircle24" Filled="True" FontSize="16" Margin="0,1,10,0" VerticalAlignment="Top"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                    <TextBlock x:Name="ErrorText" Grid.Column="1" TextWrapping="Wrap" FontSize="13" Style="{StaticResource PrimaryText}" />
                </Grid>
            </Border>
        </StackPanel>

        <!-- ============ Footer (ContentDialog-style command area) ============ -->
        <Border Grid.Row="2" Padding="24,16,24,20" BorderThickness="0,1,0,0"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:HyperlinkButton x:Name="SecondaryLink" Grid.Column="0" Padding="8,6" Margin="-8,0,8,0"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" Click="OnSecondaryClick" />

                <ui:Button x:Name="PrimaryButton" Grid.Column="1" Appearance="Primary" MinWidth="140" Height="36"
                           IsDefault="True" Click="OnPrimaryClick">
                    <StackPanel Orientation="Horizontal">
                        <ui:ProgressRing x:Name="BusyRing" Width="16" Height="16" Margin="0,0,10,0" IsIndeterminate="True"
                                         Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" Visibility="Collapsed" />
                        <TextBlock x:Name="PrimaryLabel" VerticalAlignment="Center" />
                    </StackPanel>
                </ui:Button>

                <ui:Button x:Name="CloseButton" Grid.Column="2" Margin="8,0,0,0" MinWidth="110" Height="36"
                           Content="Отмена" IsCancel="True" Click="OnCloseClick" Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
