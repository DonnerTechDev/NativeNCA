<ui:ContentDialog x:Class="NativeNCA.App.Views.Dialogs.ChangePasswordDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:local="clr-namespace:NativeNCA.App.Views.Dialogs"
                  xmlns:l="clr-namespace:NativeNCA.App.Localization"
                  Title="{l:Loc ChangePassword_Title}"
                  PrimaryButtonText="{l:Loc Key_ChangePassword}"
                  CloseButtonText="{l:Loc Common_Cancel}"
                  DefaultButton="Primary"
                  DialogMaxWidth="520">

    <ui:ContentDialog.Resources>
        <Style BasedOn="{StaticResource {x:Type ui:ContentDialog}}" TargetType="{x:Type local:ChangePasswordDialog}" />
    </ui:ContentDialog.Resources>

    <StackPanel Width="420">
        <TextBlock x:Name="KeyNameText" TextWrapping="Wrap" Style="{StaticResource SecondaryText}" FontSize="13" />

        <TextBlock Text="{l:Loc ChangePassword_Current}" Margin="0,20,0,6" Style="{StaticResource FieldLabelText}" />
        <ui:PasswordBox x:Name="CurrentPasswordInput" Icon="{ui:SymbolIcon Password24}" PlaceholderText="{l:Loc ChangePassword_Current}" />

        <TextBlock Text="{l:Loc ChangePassword_New}" Margin="0,16,0,6" Style="{StaticResource FieldLabelText}" />
        <ui:PasswordBox x:Name="NewPasswordInput" Icon="{ui:SymbolIcon KeyReset24}" PlaceholderText="{l:Loc ChangePassword_New}" />

        <TextBlock Text="{l:Loc ChangePassword_Repeat}" Margin="0,16,0,6" Style="{StaticResource FieldLabelText}" />
        <ui:PasswordBox x:Name="ConfirmPasswordInput" Icon="{ui:SymbolIcon KeyReset24}" PlaceholderText="{l:Loc ChangePassword_RepeatPlaceholder}" />

        <StackPanel x:Name="VaultHint" Orientation="Horizontal" Margin="2,12,0,0" Visibility="Collapsed">
            <ui:SymbolIcon Symbol="ShieldCheckmark16" FontSize="14" Margin="0,0,6,0"
                           Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
            <TextBlock Text="{l:Loc ChangePassword_VaultHint}" Style="{StaticResource SecondaryText}" />
        </StackPanel>

        <ui:InfoBar x:Name="ErrorBar" Margin="0,16,0,0" Severity="Error" IsClosable="False" IsOpen="False"
                    Title="{l:Loc ChangePassword_ErrorTitle}" />
    </StackPanel>
</ui:ContentDialog>
