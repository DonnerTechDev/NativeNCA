<ui:ContentDialog x:Class="NativeNCA.App.Views.Dialogs.ChangePasswordDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:local="clr-namespace:NativeNCA.App.Views.Dialogs"
                  Title="Сменить пароль ключа"
                  PrimaryButtonText="Сменить пароль"
                  CloseButtonText="Отмена"
                  DefaultButton="Primary"
                  DialogMaxWidth="520">

    <ui:ContentDialog.Resources>
        <Style BasedOn="{StaticResource {x:Type ui:ContentDialog}}" TargetType="{x:Type local:ChangePasswordDialog}" />
    </ui:ContentDialog.Resources>

    <StackPanel Width="420">
        <TextBlock x:Name="KeyNameText" TextWrapping="Wrap" Style="{StaticResource SecondaryText}" FontSize="13" />

        <TextBlock Text="Текущий пароль" Margin="0,20,0,6" Style="{StaticResource FieldLabelText}" />
        <ui:PasswordBox x:Name="CurrentPasswordInput" Icon="{ui:SymbolIcon Password24}" PlaceholderText="Текущий пароль" />

        <TextBlock Text="Новый пароль" Margin="0,16,0,6" Style="{StaticResource FieldLabelText}" />
        <ui:PasswordBox x:Name="NewPasswordInput" Icon="{ui:SymbolIcon KeyReset24}" PlaceholderText="Новый пароль" />

        <TextBlock Text="Повторите новый пароль" Margin="0,16,0,6" Style="{StaticResource FieldLabelText}" />
        <ui:PasswordBox x:Name="ConfirmPasswordInput" Icon="{ui:SymbolIcon KeyReset24}" PlaceholderText="Ещё раз" />

        <StackPanel x:Name="VaultHint" Orientation="Horizontal" Margin="2,12,0,0" Visibility="Collapsed">
            <ui:SymbolIcon Symbol="ShieldCheckmark16" FontSize="14" Margin="0,0,6,0"
                           Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
            <TextBlock Text="Сохранённый в Vault пароль обновится автоматически" Style="{StaticResource SecondaryText}" />
        </StackPanel>

        <ui:InfoBar x:Name="ErrorBar" Margin="0,16,0,0" Severity="Error" IsClosable="False" IsOpen="False"
                    Title="Не удалось сменить пароль" />
    </StackPanel>
</ui:ContentDialog>
