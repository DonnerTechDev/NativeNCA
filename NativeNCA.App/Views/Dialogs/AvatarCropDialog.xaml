<ui:ContentDialog x:Class="NativeNCA.App.Views.Dialogs.AvatarCropDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:local="clr-namespace:NativeNCA.App.Views.Dialogs"
                  Title="Фото ключа"
                  PrimaryButtonText="Сохранить"
                  CloseButtonText="Отмена"
                  DefaultButton="Primary"
                  DialogMaxWidth="520">

    <ui:ContentDialog.Resources>
        <Style BasedOn="{StaticResource {x:Type ui:ContentDialog}}" TargetType="{x:Type local:AvatarCropDialog}" />
    </ui:ContentDialog.Resources>

    <StackPanel Width="400">
        <TextBlock TextWrapping="Wrap" Style="{StaticResource SecondaryText}" FontSize="13"
                   Text="Фото поможет сразу узнать ключ в списке и в окне подписи." />

        <!-- Crop viewport: drag to move, wheel or slider to zoom; the circle is what will be saved -->
        <Border Width="282" Height="282" Margin="0,14,0,0" HorizontalAlignment="Center" CornerRadius="8" ClipToBounds="True"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
            <Grid>
                <Canvas x:Name="Viewport" Width="280" Height="280" ClipToBounds="True" Background="Transparent"
                        MouseLeftButtonDown="OnViewportMouseDown" MouseMove="OnViewportMouseMove"
                        MouseLeftButtonUp="OnViewportMouseUp" MouseWheel="OnViewportMouseWheel">
                    <Image x:Name="Photo" RenderOptions.BitmapScalingMode="HighQuality" />
                </Canvas>

                <Grid x:Name="CropOverlay" IsHitTestVisible="False" Visibility="Collapsed">
                    <Path Fill="#99000000" Data="F0 M0,0 H280 V280 H0 Z M16,140 A124,124 0 1 0 264,140 A124,124 0 1 0 16,140 Z" />
                    <Ellipse Width="248" Height="248" Stroke="White" StrokeThickness="2" Opacity="0.9" />
                </Grid>

                <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="ImageAdd24" FontSize="40" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="Перетащите фото сюда" Margin="0,10,0,12" HorizontalAlignment="Center"
                               Style="{StaticResource SecondaryText}" FontSize="13" />
                    <ui:Button Content="Выбрать файл…" Icon="{ui:SymbolIcon FolderOpen24}" HorizontalAlignment="Center"
                               Click="OnBrowseClick" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="Controls" Margin="60,12,60,0" IsEnabled="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:SymbolIcon Symbol="ZoomOut20" FontSize="16" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <Slider x:Name="ZoomSlider" Grid.Column="1" Margin="10,0" Minimum="1" Maximum="6" Value="1"
                    SmallChange="0.1" LargeChange="0.5" VerticalAlignment="Center"
                    AutomationProperties.Name="Масштаб" ValueChanged="OnZoomChanged" />
            <ui:SymbolIcon Grid.Column="2" Symbol="ZoomIn20" FontSize="16" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <ui:Button x:Name="ChangeButton" Content="Другое фото…" Icon="{ui:SymbolIcon FolderOpen24}"
                       Visibility="Collapsed" Click="OnBrowseClick" Margin="0,0,8,0" />
            <ui:Button x:Name="RemoveButton" Content="Удалить фото" Icon="{ui:SymbolIcon Delete24}"
                       Visibility="Collapsed" Click="OnRemoveClick" />
        </StackPanel>

        <ui:InfoBar x:Name="ErrorBar" Margin="0,12,0,0" Severity="Error" IsClosable="False" IsOpen="False"
                    Title="Не удалось открыть изображение" />
    </StackPanel>
</ui:ContentDialog>
