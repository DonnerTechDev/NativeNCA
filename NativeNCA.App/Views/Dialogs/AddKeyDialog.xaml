<ui:ContentDialog x:Class="NativeNCA.App.Views.Dialogs.AddKeyDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:local="clr-namespace:NativeNCA.App.Views.Dialogs"
                  xmlns:l="clr-namespace:NativeNCA.App.Localization"
                  Title="{l:Loc AddKey_Title}"
                  PrimaryButtonText="{l:Loc AddKey_Add}"
                  CloseButtonText="{l:Loc Common_Cancel}"
                  DefaultButton="Primary"
                  DialogMaxWidth="560">

    <ui:ContentDialog.Resources>
        <Style BasedOn="{StaticResource {x:Type ui:ContentDialog}}" TargetType="{x:Type local:AddKeyDialog}" />
    </ui:ContentDialog.Resources>

    <StackPanel Width="460">
        <TextBlock TextWrapping="Wrap" Style="{StaticResource SecondaryText}" FontSize="13"
                   Text="{l:Loc AddKey_Intro}" />

        <!-- File picker / drop zone -->
        <TextBlock Text="{l:Loc AddKey_FileLabel}" Margin="0,20,0,6" Style="{StaticResource FieldLabelText}" />
        <Border x:Name="DropZone" CornerRadius="8" BorderThickness="1" Padding="14,12" AllowDrop="True"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                DragEnter="OnDragEnter" DragLeave="OnDragLeave" DragOver="OnDragOver" Drop="OnDrop">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="8" Margin="0,0,12,0"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                    <ui:SymbolIcon x:Name="FileIcon" Symbol="DocumentLock24" FontSize="22"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="FileNameText" Text="{l:Loc AddKey_FilePrompt}"
                               Style="{StaticResource PrimaryText}" />
                    <TextBlock x:Name="FilePathText" Text="{l:Loc AddKey_FileHint}"
                               Style="{StaticResource TertiaryText}" />
                </StackPanel>
                <ui:Button Grid.Column="2" Content="{l:Loc AddKey_Browse}" Margin="12,0,0,0" Click="OnBrowseClick" />
            </Grid>
        </Border>

        <!-- Name -->
        <TextBlock Text="{l:Loc AddKey_NameLabel}" Margin="0,16,0,6" Style="{StaticResource FieldLabelText}" />
        <ui:TextBox x:Name="NameInput" PlaceholderText="{l:Loc AddKey_NamePlaceholder}"
                    Icon="{ui:SymbolIcon Tag24}" ClearButtonEnabled="True" MaxLength="64" />

        <!-- Password -->
        <TextBlock Text="{l:Loc Common_KeyPassword}" Margin="0,16,0,6" Style="{StaticResource FieldLabelText}" />
        <ui:PasswordBox x:Name="PasswordInput" PlaceholderText="{l:Loc AddKey_PasswordPlaceholder}"
                        Icon="{ui:SymbolIcon Password24}" />

        <!-- Save password -->
        <Border Margin="0,16,0,0" CornerRadius="8" Padding="12,10" BorderThickness="1"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <StackPanel>
                <CheckBox x:Name="SavePasswordCheck" IsChecked="True">
                    <TextBlock Text="{l:Loc AddKey_SavePassword}" Style="{StaticResource PrimaryText}" />
                </CheckBox>
                <TextBlock Margin="28,2,0,0" TextWrapping="Wrap" Style="{StaticResource SecondaryText}"
                           Text="{l:Loc AddKey_SavePasswordHint}" />
            </StackPanel>
        </Border>

        <ui:InfoBar x:Name="ErrorBar" Margin="0,16,0,0" Severity="Error" IsClosable="False" IsOpen="False"
                    Title="{l:Loc AddKey_ErrorTitle}" />
    </StackPanel>
</ui:ContentDialog>
