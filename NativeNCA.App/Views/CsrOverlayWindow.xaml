<ui:FluentWindow x:Class="NativeNCA.App.Views.CsrOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:l="clr-namespace:NativeNCA.App.Localization"
        xmlns:vm="clr-namespace:NativeNCA.Core.ViewModels;assembly=NativeNCA.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:CsrOverlayViewModel}"
        Title="{l:Loc Overlay_WindowTitle}"
        Icon="pack://application:,,,/NativeNCA;component/Assets/app.ico"
        Width="480"
        SizeToContent="Height"
        MaxHeight="760"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        ExtendsContentIntoTitleBar="True">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar with app icon/title -->
        <ui:TitleBar Grid.Row="0"
                     Title="NativeNCA"
                     ShowMinimize="False"
                     ShowMaximize="False"
                     CanMaximize="False">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="ShieldKeyhole24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Main content inside ScrollViewer -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="24,4,24,20">
                <!-- Header: Key icon + Description -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Width="48" Height="48" CornerRadius="12" VerticalAlignment="Top"
                            Background="{DynamicResource AccentFillColorDefaultBrush}">
                        <ui:SymbolIcon Symbol="Key24" FontSize="26" Filled="True"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{l:Loc Overlay_CsrTitle}" FontSize="20" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Margin="0,2,0,0" Text="{l:Loc Overlay_CsrSubtitle}"
                                   Style="{StaticResource SecondaryText}" FontSize="13" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <!-- Origin card -->
                <Border Padding="14,10" CornerRadius="8" BorderThickness="1"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:SymbolIcon Grid.Column="0" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center">
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Setter Property="Symbol" Value="LockClosed24" />
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSecureOrigin}" Value="False">
                                            <Setter Property="Symbol" Value="ShieldError24" />
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding OriginDomain}" FontSize="15" FontWeight="SemiBold"
                                       Style="{StaticResource PrimaryText}" ToolTip="{Binding OriginUrl}" />
                            <TextBlock Text="{Binding OriginUrl}" Style="{StaticResource TertiaryText}" />
                        </StackPanel>

                        <Border Grid.Column="2" Margin="10,0,0,0" CornerRadius="10" Padding="8,2,8,3" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSecureOrigin}" Value="False">
                                            <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock FontSize="11" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="HTTPS" />
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSecureOrigin}" Value="False">
                                                <Setter Property="Text" Value="{l:Loc Overlay_NotSecure}" />
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </Grid>
                </Border>

                <!-- Subject Details Card -->
                <TextBlock Text="{l:Loc Overlay_CsrSubject}" Margin="2,16,0,6" Style="{StaticResource SecondaryText}" />
                <Border Padding="14,12" CornerRadius="8" BorderThickness="1"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock Text="{Binding SubjectCommonName}" FontWeight="SemiBold" FontSize="14"
                                   Style="{StaticResource PrimaryText}" />

                        <WrapPanel Margin="0,6,0,0">
                            <TextBlock Visibility="{Binding HasIin, Converter={StaticResource BoolToVisibility}}"
                                       Margin="0,0,16,0" Style="{StaticResource SecondaryText}">
                                <Run Text="{l:Loc Key_Iin}" /><Run Text=": " /><Run Text="{Binding SubjectIin, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>

                            <TextBlock Visibility="{Binding HasBin, Converter={StaticResource BoolToVisibility}}"
                                       Margin="0,0,16,0" Style="{StaticResource SecondaryText}">
                                <Run Text="{l:Loc Key_Bin}" /><Run Text=": " /><Run Text="{Binding SubjectBin, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                        </WrapPanel>

                        <TextBlock Visibility="{Binding HasOrganization, Converter={StaticResource BoolToVisibility}}"
                                   Margin="0,4,0,0" Style="{StaticResource SecondaryText}">
                            <Run Text="{l:Loc Key_Organization}" /><Run Text=": " /><Run Text="{Binding SubjectOrganization, Mode=OneWay}" />
                        </TextBlock>

                        <TextBlock Margin="0,4,0,0" Style="{StaticResource TertiaryText}">
                            <Run Text="{l:Loc Overlay_CsrAlgorithm}" /><Run Text=": " /><Run Text="{Binding KeyAlgorithm, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Backup .p12 option -->
                <Border Margin="0,16,0,0" Padding="14,10" CornerRadius="8" BorderThickness="1"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding SaveBackupCopy, Mode=TwoWay}"
                                  Content="{l:Loc Overlay_CsrSaveBackup}" FontWeight="SemiBold" />

                        <StackPanel Visibility="{Binding SaveBackupCopy, Converter={StaticResource BoolToVisibility}}" Margin="0,10,0,0">
                            <TextBlock Text="{l:Loc Overlay_CsrBackupFolder}" Style="{StaticResource FieldLabelText}" Margin="0,0,0,4" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Text="{Binding BackupFolder, Mode=TwoWay}" IsReadOnly="True" />
                                <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="{l:Loc AddKey_Browse}" Click="OnBrowseFolderClick" />
                            </Grid>

                            <TextBlock Text="{l:Loc Common_KeyPassword}" Style="{StaticResource FieldLabelText}" Margin="0,8,0,4" />
                            <ui:PasswordBox x:Name="PasswordInput" PlaceholderText="{l:Loc AddKey_PasswordPlaceholder}"
                                            PasswordChanged="OnPasswordChanged" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer (ContentDialog-style command area) -->
        <Border Grid.Row="2" Padding="24,16,24,20" BorderThickness="0,1,0,0"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ui:Button x:Name="ApproveButton" Grid.Column="0"
                           Appearance="Primary"
                           Command="{Binding ApproveCommand}"
                           IsDefault="True"
                           HorizontalAlignment="Stretch"
                           Height="36">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Key24" FontSize="18" Margin="0,0,8,0" />
                        <TextBlock Text="{l:Loc Overlay_CsrGenerateButton}" FontWeight="SemiBold" />
                    </StackPanel>
                </ui:Button>

                <ui:Button Grid.Column="2"
                           Content="{l:Loc Common_Cancel}"
                           Command="{Binding CancelCommand}"
                           IsCancel="True"
                           HorizontalAlignment="Stretch"
                           Height="36" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
