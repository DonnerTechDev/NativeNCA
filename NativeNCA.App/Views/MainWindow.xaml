<ui:FluentWindow x:Class="NativeNCA.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:tray="http://schemas.lepo.co/wpfui/2022/xaml/tray"
        xmlns:vm="clr-namespace:NativeNCA.Core.ViewModels;assembly=NativeNCA.Core"
        xmlns:sec="clr-namespace:NativeNCA.Core.Security;assembly=NativeNCA.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
        Title="NativeNCA"
        Icon="pack://application:,,,/NativeNCA;component/Assets/app.ico"
        Width="1080" Height="720"
        MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        ExtendsContentIntoTitleBar="True">

    <ui:FluentWindow.Resources>
        <!-- Key card in the left pane -->
        <DataTemplate x:Key="KeyCardTemplate" DataType="{x:Type vm:KeyItemViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ContentControl Template="{StaticResource KeyAvatarView}" Width="40" Height="40" FontSize="14"
                                Margin="0,0,12,0" VerticalAlignment="Top" Focusable="False" />

                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Style="{StaticResource PrimaryText}" />
                    <TextBlock Text="{Binding FullName}" Margin="0,1,0,0" Style="{StaticResource SecondaryText}" />
                    <DockPanel Margin="0,6,0,0" LastChildFill="False">
                        <ContentControl DockPanel.Dock="Left" Template="{StaticResource KeyStatusBadge}" Focusable="False" />
                        <ui:SymbolIcon DockPanel.Dock="Right" Symbol="LockClosed16" FontSize="14" Margin="8,0,0,0"
                                       ToolTip="Пароль хранится в защищённом хранилище"
                                       Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                       Visibility="{Binding IsPasswordSaved, Converter={StaticResource BoolToVisibility}}" />
                        <ui:SymbolIcon DockPanel.Dock="Right" FontSize="14"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Setter Property="Symbol" Value="Signature20" />
                                    <Setter Property="ToolTip" Value="Ключ для подписи (SIGN)" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAuth}" Value="True">
                                            <Setter Property="Symbol" Value="PersonKey20" />
                                            <Setter Property="ToolTip" Value="Ключ для входа (AUTH)" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsAuthAndSign}" Value="True">
                                            <Setter Property="Symbol" Value="Key24" />
                                            <Setter Property="ToolTip" Value="Ключ для входа и подписи" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>
                    </DockPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Nav-style button at the bottom of the left pane ("Параметры") -->
        <Style x:Key="PaneNavButton" TargetType="ToggleButton">
            <Setter Property="Height" Value="40" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Bg" CornerRadius="6" Background="Transparent" />
                            <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                            <ContentPresenter Margin="14,0" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Banner at the top of the content layer (ui:InfoBar does not render buttons) -->
        <Style x:Key="BannerBorder" TargetType="Border">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        </Style>

        <Style x:Key="BannerIcon" TargetType="ui:SymbolIcon">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Margin" Value="0,1,12,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Filled" Value="True" />
        </Style>

        <Style x:Key="BannerTitleText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="BannerBodyText" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Tray icon: the app keeps running in the background when the window is closed -->
        <tray:NotifyIcon x:Name="TrayIcon"
                         Grid.Row="0"
                         TooltipText="NativeNCA — готов к подписанию"
                         FocusOnLeftClick="False"
                         MenuOnRightClick="True"
                         LeftClick="OnTrayLeftClick">
            <tray:NotifyIcon.Menu>
                <ContextMenu>
                    <ui:MenuItem Header="Открыть NativeNCA" Icon="{ui:SymbolIcon ShieldKeyhole24}" Click="OnTrayOpenClick" />
                    <ui:MenuItem Header="Параметры" Icon="{ui:SymbolIcon Settings24}" Click="OnTraySettingsClick" />
                    <Separator />
                    <ui:MenuItem Header="Выход" Icon="{ui:SymbolIcon Power24}" Click="OnTrayExitClick" />
                </ContextMenu>
            </tray:NotifyIcon.Menu>
        </tray:NotifyIcon>

        <ui:TitleBar Grid.Row="0" Title="NativeNCA · ЭЦП Казахстана">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="ShieldKeyhole24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===================== LEFT PANE: key vault ===================== -->
            <Grid Grid.Column="0" Margin="16,4,12,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="4,0,0,14">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Мои ключи" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Border Style="{StaticResource Pill}" Margin="10,2,0,0">
                            <TextBlock Text="{Binding Keys.Count}" Style="{StaticResource PillText}" />
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <ui:SymbolIcon Symbol="ShieldCheckmark16" FontSize="14" Margin="0,0,6,0"
                                       Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                        <TextBlock Text="Зашифрованы в хранилище Windows (DPAPI)" Style="{StaticResource SecondaryText}" />
                    </StackPanel>
                </StackPanel>

                <ListBox x:Name="KeysList" Grid.Row="1"
                         ItemsSource="{Binding Keys}"
                         SelectedItem="{Binding SelectedKey}"
                         ItemTemplate="{StaticResource KeyCardTemplate}"
                         ItemContainerStyle="{StaticResource KeyCardItem}"
                         Style="{StaticResource CardListBox}"
                         SelectionChanged="OnKeySelectionChanged"
                         PreviewMouseLeftButtonUp="OnKeysListClicked" />

                <!-- Empty vault -->
                <TextBlock Grid.Row="1" Margin="4,4,4,0" VerticalAlignment="Top" TextWrapping="Wrap"
                           Style="{StaticResource TertiaryText}"
                           Text="Здесь появятся ваши ключи ЭЦП."
                           Visibility="{Binding HasKeys, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />

                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <ui:Button Appearance="Primary"
                               Icon="{ui:SymbolIcon Add24}"
                               Content="Добавить ключ"
                               HorizontalAlignment="Stretch"
                               Height="36"
                               Click="OnAddKeyClick" />

                    <Border Height="1" Margin="4,12,4,8" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                    <ToggleButton x:Name="SettingsNavButton" Style="{StaticResource PaneNavButton}" Click="OnSettingsNavClick">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Settings24" FontSize="18" Margin="0,0,12,0" />
                            <TextBlock Text="Параметры" FontSize="14" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>
            </Grid>

            <!-- ===================== RIGHT PANE: content layer ===================== -->
            <Border Grid.Column="1" CornerRadius="8,0,0,0" BorderThickness="1,1,0,0"
                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Banners, most important first; the host collapses when none is shown -->
                <StackPanel x:Name="BannerHost" Grid.Row="0" Margin="24,8,24,0">

                <!-- Server problem banner (NCALayer holds the port, no TLS certificate, ...) with its fix -->
                <Border x:Name="ServerBanner"
                        Visibility="{Binding ServerError, Converter={StaticResource NullToVisibilityConverter}}">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource BannerBorder}">
                            <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNcaLayerConflict}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon FontSize="18" Margin="0,1,12,0" VerticalAlignment="Top" Filled="True">
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Setter Property="Symbol" Value="ErrorCircle24" />
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNcaLayerConflict}" Value="True">
                                            <Setter Property="Symbol" Value="Warning24" />
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ServerErrorTitle, StringFormat='{}{0} — сайты не увидят NativeNCA'}" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding ServerError}" Margin="0,2,0,0" FontSize="13" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <WrapPanel Margin="0,12,0,0">
                                <ui:Button Margin="0,0,8,0" Appearance="Primary" Content="Закрыть NCALayer"
                                           Icon="{ui:SymbolIcon Dismiss24}" Click="OnCloseNcaLayerClick"
                                           Visibility="{Binding IsNcaLayerConflict, Converter={StaticResource BoolToVisibility}}" />
                                <ui:Button Margin="0,0,8,0" Content="Отключить автозапуск NCALayer"
                                           Icon="{ui:SymbolIcon Power24}" Click="OnDisableNcaLayerAutostartClick">
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsNcaLayerConflict}" Value="True" />
                                                        <Condition Binding="{Binding IsNcaLayerAutostartEnabled}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                                <ui:Button Margin="0,0,8,0" Appearance="Primary" Content="Настроить сертификат"
                                           Icon="{ui:SymbolIcon Certificate24}" Click="OnInstallTlsCertificateClick"
                                           Visibility="{Binding IsCertificateError, Converter={StaticResource BoolToVisibility}}" />
                                <ui:Button Content="Повторить" Icon="{ui:SymbolIcon ArrowSync24}"
                                           Command="{Binding RetryServerCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- The vault was written by a newer NativeNCA: read-only until updated -->
                <Border x:Name="VaultReadOnlyBanner" Style="{StaticResource BannerBorder}"
                        Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                        Visibility="{Binding VaultReadOnlyMessage, Converter={StaticResource NullToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Warning24" Style="{StaticResource BannerIcon}"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Хранилище ключей открыто только для чтения" Style="{StaticResource BannerTitleText}" />
                            <TextBlock Text="{Binding VaultReadOnlyMessage}" Style="{StaticResource BannerBodyText}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- A newer version is available / downloading -->
                <Border x:Name="UpdateBanner" Style="{StaticResource BannerBorder}"
                        Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                        Visibility="{Binding IsUpdateBannerVisible, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="ArrowCircleUp24" Style="{StaticResource BannerIcon}"
                                       Foreground="{DynamicResource SystemFillColorAttentionBrush}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding UpdateBannerTitle}" Style="{StaticResource BannerTitleText}" />
                            <TextBlock Text="{Binding UpdateBannerText}" Style="{StaticResource BannerBodyText}" />

                            <Grid Margin="0,8,0,0"
                                  Visibility="{Binding UpdateError, Converter={StaticResource NullToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="ErrorCircle16" Filled="True" FontSize="14" Margin="0,2,6,0" VerticalAlignment="Top"
                                               Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding UpdateError}" FontSize="13" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Grid>

                            <WrapPanel Margin="0,12,0,0"
                                       Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                <ui:Button Margin="0,0,8,0" Appearance="Primary" Content="Обновить"
                                           Icon="{ui:SymbolIcon ArrowDownload24}" Command="{Binding UpdateNowCommand}" />
                                <ui:HyperlinkButton Content="Что нового" NavigateUri="{Binding ReleaseNotesUrl}" />
                            </WrapPanel>

                            <Grid Margin="0,12,0,0"
                                  Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding DownloadFraction, Mode=OneWay}"
                                                 IsIndeterminate="{Binding IsDownloadIndeterminate}" />
                                    <TextBlock Text="{Binding DownloadText}" Margin="0,6,0,0" Style="{StaticResource SecondaryText}" />
                                </StackPanel>
                                <ui:Button Grid.Column="1" Margin="16,0,0,0" Content="Отмена" VerticalAlignment="Center"
                                           Command="{Binding CancelDownloadCommand}" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- After an update, a rollback or the installation: closable -->
                <Border x:Name="RestartBanner" Style="{StaticResource BannerBorder}"
                        Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}"
                        Visibility="{Binding RestartBannerText, Converter={StaticResource NullToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="CheckmarkCircle24" Style="{StaticResource BannerIcon}"
                                       Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding RestartBannerText}" Style="{StaticResource BannerBodyText}" Margin="0" />
                            <ui:HyperlinkButton Content="Открыть параметры" Margin="-8,4,0,-4" Padding="8,4" HorizontalAlignment="Left"
                                                Click="OnOpenSettingsFromBannerClick"
                                                Visibility="{Binding HasPreviousVersion, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <ui:Button Grid.Column="2" Margin="12,-4,-8,-4" VerticalAlignment="Top" Style="{StaticResource IconButton}"
                                   Icon="{ui:SymbolIcon Dismiss16}" ToolTip="Закрыть"
                                   Command="{Binding DismissRestartBannerCommand}" />
                    </Grid>
                </Border>
                </StackPanel>

                <Grid x:Name="ContentHost" Grid.Row="1" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TranslateTransform />
                    </Grid.RenderTransform>

                    <!-- ============ Key details ============ -->
                    <ScrollViewer x:Name="KeyDetailsView" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="36,28,36,36" MaxWidth="880" DataContext="{Binding SelectedKey}">

                            <!-- Hero -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Clickable avatar: opens the picture/crop dialog -->
                                <Button x:Name="AvatarButton" Width="72" Height="72" Cursor="Hand" VerticalAlignment="Center"
                                        ToolTip="Изменить фото ключа" AutomationProperties.Name="Изменить фото ключа"
                                        Click="OnAvatarClick">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Grid>
                                                <ContentControl Template="{StaticResource KeyAvatarView}" FontSize="26" Focusable="False" />
                                                <Grid x:Name="Hover" Opacity="0">
                                                    <Ellipse Fill="#8C000000" />
                                                    <ui:SymbolIcon Symbol="Camera24" FontSize="24" Foreground="White" />
                                                </Grid>
                                                <Border Width="24" Height="24" CornerRadius="12" BorderThickness="1"
                                                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2"
                                                        Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
                                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                                    <ui:SymbolIcon Symbol="Camera20" FontSize="13"
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                </Border>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="Hover" Property="Opacity" Value="1" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <StackPanel Grid.Column="1" Margin="20,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource PageTitleText}" />
                                    <TextBlock Text="{Binding Organization}" Margin="0,2,0,0" FontSize="14"
                                               Style="{StaticResource SecondaryText}" />
                                    <WrapPanel Margin="0,10,0,0">
                                        <ContentControl Template="{StaticResource KeyStatusBadge}" Margin="0,0,12,0" Focusable="False" />
                                        <ContentControl Template="{StaticResource KeyUsagePill}" Margin="0,0,6,0" Focusable="False" />
                                        <Border Style="{StaticResource Pill}" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding KeyAlgorithm}" Style="{StaticResource PillText}" />
                                        </Border>
                                        <ContentControl Template="{StaticResource SavedPasswordPill}" Focusable="False" />
                                    </WrapPanel>
                                </StackPanel>

                                <ui:Button Grid.Column="2" VerticalAlignment="Top"
                                           Icon="{ui:SymbolIcon Rename24}" Content="Переименовать"
                                           Click="OnRenameKeyClick" />
                            </Grid>

                            <!-- Expiry warning -->
                            <ui:InfoBar Margin="0,20,0,0" Severity="Warning" IsClosable="False"
                                        Title="Срок действия скоро закончится"
                                        Message="Перевыпустите ключ на pki.gov.kz заранее, чтобы не потерять доступ к eGov и банкам."
                                        IsOpen="{Binding IsExpiringSoon}" />
                            <ui:InfoBar Margin="0,20,0,0" Severity="Error" IsClosable="False"
                                        Title="Сертификат истёк"
                                        Message="Этот ключ больше нельзя использовать для подписи. Получите новый ключ в НУЦ РК."
                                        IsOpen="{Binding IsExpired}" />

                            <!-- Certificate -->
                            <TextBlock Text="Сертификат" Style="{StaticResource SectionHeaderText}" />
                            <ui:Card Padding="16,0">
                                <StackPanel>
                                    <Grid Style="{StaticResource DetailRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Владелец" Style="{StaticResource DetailLabelText}" />
                                        <TextBlock Grid.Column="1" Text="{Binding FullName}" Style="{StaticResource DetailValueText}" />
                                    </Grid>
                                    <Border Style="{StaticResource RowDivider}" />

                                    <Grid Style="{StaticResource DetailRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="ИИН" Style="{StaticResource DetailLabelText}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Iin}" FontFamily="{StaticResource MonoFontFamily}" Style="{StaticResource DetailValueText}" />
                                        <ui:Button Grid.Column="2" Style="{StaticResource IconButton}" ToolTip="Скопировать ИИН"
                                                   Icon="{ui:SymbolIcon Copy16}" Tag="{Binding Iin}" Click="OnCopyClick" />
                                    </Grid>
                                    <Border Style="{StaticResource RowDivider}" />

                                    <!-- БИН: only for legal entities -->
                                    <StackPanel Visibility="{Binding HasBin, Converter={StaticResource BoolToVisibility}}">
                                        <Grid Style="{StaticResource DetailRow}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="БИН" Style="{StaticResource DetailLabelText}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Bin}" FontFamily="{StaticResource MonoFontFamily}" Style="{StaticResource DetailValueText}" />
                                            <ui:Button Grid.Column="2" Style="{StaticResource IconButton}" ToolTip="Скопировать БИН"
                                                       Icon="{ui:SymbolIcon Copy16}" Tag="{Binding Bin}" Click="OnCopyClick" />
                                        </Grid>
                                        <Border Style="{StaticResource RowDivider}" />
                                    </StackPanel>

                                    <Grid Style="{StaticResource DetailRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Организация" Style="{StaticResource DetailLabelText}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Organization}" Style="{StaticResource DetailValueText}" />
                                    </Grid>
                                    <Border Style="{StaticResource RowDivider}" />

                                    <Grid Style="{StaticResource DetailRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Срок действия" Style="{StaticResource DetailLabelText}" />
                                        <TextBlock Grid.Column="1" Text="{Binding ValidityPeriodText}" Style="{StaticResource DetailValueText}" />
                                    </Grid>
                                    <Border Style="{StaticResource RowDivider}" />

                                    <Grid Style="{StaticResource DetailRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Назначение" Style="{StaticResource DetailLabelText}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource DetailValueText}">
                                            <Run Text="{Binding BadgeText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding KeyAlgorithm, Mode=OneWay}" />
                                        </TextBlock>
                                    </Grid>
                                    <Border Style="{StaticResource RowDivider}" />

                                    <Grid Style="{StaticResource DetailRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Издатель" Style="{StaticResource DetailLabelText}" />
                                        <TextBlock Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Issuer}" FontSize="12"
                                                   Style="{StaticResource DetailValueText}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </StackPanel>
                            </ui:Card>

                            <!-- Security -->
                            <TextBlock Text="Безопасность" Style="{StaticResource SectionHeaderText}" />

                            <ui:CardControl Style="{StaticResource SettingsCard}" Icon="{ui:SymbolIcon LockClosed24}">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Сохранить пароль в защищённом хранилище" Style="{StaticResource SettingsTitleText}" />
                                        <TextBlock Text="Пароль шифруется Windows DPAPI — при подписании останется только подтверждение Windows Hello"
                                                   Style="{StaticResource SettingsDescriptionText}" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch x:Name="SavePasswordToggle"
                                                 IsChecked="{Binding IsPasswordSaved, Mode=OneWay}"
                                                 Click="OnSavePasswordToggleClick" />
                            </ui:CardControl>

                            <ui:CardControl Style="{StaticResource SettingsCard}" Icon="{ui:SymbolIcon KeyReset24}">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Пароль ключа" Style="{StaticResource SettingsTitleText}" />
                                        <TextBlock Text="Перешифровать ключ новым паролем. Исходный файл .p12 на диске не изменится"
                                                   Style="{StaticResource SettingsDescriptionText}" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:Button Content="Сменить пароль" Click="OnChangePasswordClick" />
                            </ui:CardControl>

                            <ui:CardControl Style="{StaticResource SettingsCard}" Icon="{ui:SymbolIcon Delete24}">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Удалить ключ из хранилища" Style="{StaticResource SettingsTitleText}" />
                                        <TextBlock Text="Зашифрованная копия и сохранённый пароль будут удалены без возможности восстановления"
                                                   Style="{StaticResource SettingsDescriptionText}" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:Button Content="Удалить" Appearance="Danger" Icon="{ui:SymbolIcon Delete24}" Click="OnDeleteKeyClick" />
                            </ui:CardControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ============ Settings ============ -->
                    <ScrollViewer x:Name="SettingsView" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel Margin="36,28,36,36" MaxWidth="880">
                            <TextBlock Text="Параметры" Style="{StaticResource PageTitleText}" />

                            <TextBlock Text="Подписание" Style="{StaticResource SectionHeaderText}" />

                            <ui:CardControl Style="{StaticResource SettingsCard}" Icon="{ui:SymbolIcon Fingerprint24}">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Windows Hello при каждом подписании" Style="{StaticResource SettingsTitleText}" />
                                        <TextBlock Text="Подтверждение лицом, отпечатком пальца или PIN-кодом перед использованием ключа"
                                                   Style="{StaticResource SettingsDescriptionText}" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch IsChecked="{Binding RequireWindowsHello}"
                                                 IsEnabled="{Binding IsHelloProtected, Converter={StaticResource InverseBool}}" />
                            </ui:CardControl>

                            <ui:InfoBar x:Name="HelloUnavailableBar" Margin="0,0,0,4" Severity="Warning" IsClosable="False"
                                        Title="Windows Hello не настроен"
                                        Message="На этом устройстве нет PIN-кода или биометрии — подтверждение будет пропускаться. Настройте Windows Hello в «Параметры → Учётные записи → Варианты входа»." />

                            <ui:CardControl Style="{StaticResource SettingsCard}" Icon="{ui:SymbolIcon Timer24}">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Запоминать подтверждение" Style="{StaticResource SettingsTitleText}" />
                                        <TextBlock Text="Не запрашивать Windows Hello повторно для того же сайта в течение выбранного времени"
                                                   Style="{StaticResource SettingsDescriptionText}" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ComboBox MinWidth="160"
                                          ItemsSource="{Binding SessionCacheOptions}"
                                          SelectedItem="{Binding SessionCacheMinutes}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource CacheMinutesToText}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </ui:CardControl>

                            <ui:CardControl Style="{StaticResource SettingsCard}" Icon="{ui:SymbolIcon Clock24}">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Метка времени НУЦ (CAdES-T)" Style="{StaticResource SettingsTitleText}" />
                                        <TextBlock Text="Сервер НУЦ подтверждает время подписания — подпись остаётся проверяемой и после окончания срока сертификата. Нужен интернет"
                                                   Style="{StaticResource SettingsDescriptionText}" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch IsChecked="{Binding UseTimestamp}" />
                            </ui:CardControl>

                            <TextBlock Text="Хранилище" Style="{StaticResource SectionHeaderText}" />

                            <ui:CardControl Style="{StaticResource SettingsCard}" Icon="{ui:SymbolIcon ShieldLock24}">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Защитить хранилище Windows Hello" Style="{StaticResource SettingsTitleText}" />
                                        <TextBlock Text="Ключи и пароли дополнительно шифруются ключом Windows Hello из TPM. Без лица, отпечатка или PIN-кода их не расшифрует даже программа, запущенная от вашего имени"
                                                   Style="{StaticResource SettingsDescriptionText}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                                    Visibility="{Binding IsHelloProtected, Converter={StaticResource BoolToVisibility}}">
                                            <ui:SymbolIcon FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="ui:SymbolIcon">
                                                        <Setter Property="Symbol" Value="LockClosed16" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsVaultUnlocked}" Value="True">
                                                                <Setter Property="Symbol" Value="LockOpen16" />
                                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>
                                            <TextBlock Text="{Binding VaultStateText}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:Button Content="Заблокировать" Icon="{ui:SymbolIcon LockClosed24}" Margin="0,0,12,0"
                                               Command="{Binding LockVaultCommand}"
                                               Visibility="{Binding IsHelloProtected, Converter={StaticResource BoolToVisibility}}" />
                                    <ui:ToggleSwitch x:Name="HelloVaultToggle"
                                                     IsChecked="{Binding IsHelloProtected, Mode=OneWay}"
                                                     Click="OnHelloVaultToggleClick" />
                                </StackPanel>
                            </ui:CardControl>

                            <StackPanel x:Name="UpdatesSection">
                                <TextBlock Text="Обновления" Style="{StaticResource SectionHeaderText}" />

                                <ui:CardControl Style="{StaticResource SettingsCard}" Icon="{ui:SymbolIcon ArrowSync24}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SettingsTitleText}">
                                                <Run Text="NativeNCA" /> <Run Text="{Binding CurrentVersionText, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding CheckStatusText}" Style="{StaticResource SettingsDescriptionText}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:ProgressRing Width="16" Height="16" Margin="0,0,12,0" IsIndeterminate="True"
                                                         Visibility="{Binding IsChecking, Converter={StaticResource BoolToVisibility}}" />
                                        <ui:Button Content="Обновить" Appearance="Primary" Margin="0,0,8,0"
                                                   Command="{Binding UpdateNowCommand}"
                                                   Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVisibility}}" />
                                        <ui:Button Content="Проверить обновления" Command="{Binding CheckNowCommand}" />
                                    </StackPanel>
                                </ui:CardControl>

                                <ui:CardControl Style="{StaticResource SettingsCard}" Icon="{ui:SymbolIcon ArrowSyncCheckmark24}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Автоматически проверять обновления" Style="{StaticResource SettingsTitleText}" />
                                            <TextBlock Text="Раз в несколько часов NativeNCA узнаёт на GitHub о новой версии и сообщает о ней. Устанавливаются только версии с подписью разработчика"
                                                       Style="{StaticResource SettingsDescriptionText}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch IsChecked="{Binding AutoCheck}" />
                                </ui:CardControl>

                                <ui:CardControl Style="{StaticResource SettingsCard}" Icon="{ui:SymbolIcon History24}"
                                                Visibility="{Binding HasPreviousVersion, Converter={StaticResource BoolToVisibility}}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="{Binding RollbackTitle}" Style="{StaticResource SettingsTitleText}" />
                                            <TextBlock Text="Если после обновления что-то стало работать не так. Ключи и параметры сохранятся"
                                                       Style="{StaticResource SettingsDescriptionText}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:Button Content="Вернуть" MinWidth="110" Click="OnRollbackClick" />
                                </ui:CardControl>

                                <ui:CardControl Style="{StaticResource SettingsCard}" Icon="{ui:SymbolIcon ArrowDownload24}"
                                                Visibility="{Binding IsInstalledCopy, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Установить NativeNCA" Style="{StaticResource SettingsTitleText}" />
                                            <TextBlock Text="Эта копия запущена без установки и не обновляется сама. Установленная NativeNCA есть в меню «Пуск» и получает обновления"
                                                       Style="{StaticResource SettingsDescriptionText}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:Button Content="Установить" MinWidth="110" Appearance="Primary" Click="OnInstallClick" />
                                </ui:CardControl>
                            </StackPanel>

                            <TextBlock Text="Система" Style="{StaticResource SectionHeaderText}" />

                            <ui:CardControl Style="{StaticResource SettingsCard}" Icon="{ui:SymbolIcon Power24}">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Запускать вместе с Windows" Style="{StaticResource SettingsTitleText}" />
                                        <TextBlock Text="NativeNCA будет готов к подписанию сразу после входа в систему"
                                                   Style="{StaticResource SettingsDescriptionText}" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch IsChecked="{Binding AutoStartWithWindows}" />
                            </ui:CardControl>

                            <ui:CardControl Style="{StaticResource SettingsCard}" Icon="{ui:SymbolIcon PlugConnected24}">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Локальный сервер" Style="{StaticResource SettingsTitleText}" />
                                        <TextBlock Text="Совместим с протоколом NCALayer — сайты работают без изменений"
                                                   Style="{StaticResource SettingsDescriptionText}" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="wss://127.0.0.1:13579" FontFamily="{StaticResource MonoFontFamily}" FontSize="13"
                                               VerticalAlignment="Center" Margin="0,0,12,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <Border Style="{StaticResource Pill}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Margin="0,1,6,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsServerRunning}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource PillText}">
                                                        <Setter Property="Text" Value="Остановлен" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsServerRunning}" Value="True">
                                                                <Setter Property="Text" Value="Работает" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ui:CardControl>

                            <ui:CardControl Style="{StaticResource SettingsCard}" Icon="{ui:SymbolIcon Certificate24}">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Сертификат для браузеров" Style="{StaticResource SettingsTitleText}" />
                                        <TextBlock Text="{Binding TlsDescription}" Style="{StaticResource SettingsDescriptionText}" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource Pill}" Margin="0,0,12,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Margin="0,1,6,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TlsSource}" Value="{x:Static sec:TlsCertificateSource.Own}">
                                                                <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding TlsSource}" Value="{x:Static sec:TlsCertificateSource.NcaLayer}">
                                                                <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding TlsStatusText}" Style="{StaticResource PillText}" />
                                        </StackPanel>
                                    </Border>
                                    <ui:Button Content="Удалить" MinWidth="110" Click="OnRemoveTlsCertificateClick"
                                               Visibility="{Binding IsOwnTlsCertificate, Converter={StaticResource BoolToVisibility}}" />
                                    <ui:Button Content="Установить" MinWidth="110" Appearance="Primary" Click="OnInstallTlsCertificateClick"
                                               Visibility="{Binding IsOwnTlsCertificate, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                </StackPanel>
                            </ui:CardControl>

                            <ui:CardControl x:Name="UninstallCard" Style="{StaticResource SettingsCard}" Icon="{ui:SymbolIcon Delete24}"
                                            Visibility="{Binding IsInstalledCopy, Converter={StaticResource BoolToVisibility}}">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Удалить NativeNCA" Style="{StaticResource SettingsTitleText}" />
                                        <TextBlock Text="Программа будет удалена с этого компьютера. Ключи и параметры можно сохранить или удалить вместе с ней"
                                                   Style="{StaticResource SettingsDescriptionText}" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:Button Content="Удалить" MinWidth="110" Click="OnUninstallClick" />
                            </ui:CardControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ============ Nothing selected ============ -->
                    <StackPanel x:Name="EmptyView" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="360"
                                Visibility="Collapsed">
                        <Border Width="88" Height="88" CornerRadius="44" HorizontalAlignment="Center"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                            <ui:SymbolIcon Symbol="ShieldKeyhole24" FontSize="40"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        </Border>
                        <TextBlock Text="Добро пожаловать в NativeNCA" Margin="0,20,0,6" HorizontalAlignment="Center"
                                   FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock TextAlignment="Center" TextWrapping="Wrap" FontSize="13" Style="{StaticResource SecondaryText}"
                                   Text="Добавьте ключ ЭЦП, и при подписании на eGov или в банке появится окно подтверждения через Windows Hello." />
                        <ui:Button Margin="0,20,0,0" HorizontalAlignment="Center" Appearance="Primary"
                                   Icon="{ui:SymbolIcon Add24}" Content="Добавить ключ" Click="OnAddKeyClick" />
                    </StackPanel>
                </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Hosts for ContentDialogs and toast notifications -->
        <ui:SnackbarPresenter x:Name="SnackbarPresenter" Grid.Row="1" VerticalAlignment="Bottom" />
        <ui:ContentDialogHost x:Name="DialogHost" Grid.Row="0" Grid.RowSpan="2" />
    </Grid>
</ui:FluentWindow>
