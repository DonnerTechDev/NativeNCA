<ui:FluentWindow x:Class="NativeNCA.App.Views.SignOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:l="clr-namespace:NativeNCA.App.Localization"
        xmlns:vm="clr-namespace:NativeNCA.Core.ViewModels;assembly=NativeNCA.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:SignOverlayViewModel}"
        Title="{l:Loc Overlay_WindowTitle}"
        Icon="pack://application:,,,/NativeNCA;component/Assets/app.ico"
        Width="480"
        SizeToContent="Height"
        MaxHeight="760"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        ExtendsContentIntoTitleBar="True">

    <ui:FluentWindow.Resources>
        <!-- Radio-card key template for the selector -->
        <DataTemplate x:Key="OverlayKeyTemplate" DataType="{x:Type vm:KeyItemViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Radio indicator -->
                <Grid Grid.Column="0" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Ellipse x:Name="RadioRing" StrokeThickness="1"
                             Stroke="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                             Fill="{DynamicResource ControlAltFillColorSecondaryBrush}" />
                    <Ellipse x:Name="RadioDot" Width="8" Height="8" Opacity="0"
                             Fill="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                </Grid>

                <ContentControl Grid.Column="1" Template="{StaticResource KeyAvatarView}" Width="36" Height="36" FontSize="13"
                                Margin="0,0,12,0" Focusable="False" />

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Style="{StaticResource PrimaryText}" />
                    <TextBlock Margin="0,1,0,0" Style="{StaticResource SecondaryText}">
                        <Run Text="{Binding FullName, Mode=OneWay}" /><Run Text="{l:Loc Overlay_IinPrefix}" /><Run Text="{Binding Iin, Mode=OneWay}" />
                    </TextBlock>
                    <WrapPanel Margin="0,6,0,0" Orientation="Horizontal">
                        <ContentControl Template="{StaticResource KeyStatusBadge}" Margin="0,0,10,0" Focusable="False" />
                        <ContentControl Template="{StaticResource KeyUsagePill}" Margin="0,0,6,0" Focusable="False" />
                        <ContentControl Template="{StaticResource SavedPasswordPill}" Focusable="False" />
                    </WrapPanel>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="RadioRing" Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    <Setter TargetName="RadioRing" Property="Stroke" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    <Setter TargetName="RadioDot" Property="Opacity" Value="1" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Approve button content: Hello / plain sign / processing states -->
        <Style x:Key="ApproveIcon" TargetType="ui:SymbolIcon">
            <Setter Property="Symbol" Value="Fingerprint24" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding WillAskWindowsHello}" Value="False">
                    <Setter Property="Symbol" Value="Signature24" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelectionOnly}" Value="True">
                    <Setter Property="Symbol" Value="Certificate24" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ApproveText" TargetType="TextBlock">
            <Setter Property="Text" Value="{l:Loc Overlay_ApproveHello}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding WillAskWindowsHello}" Value="False">
                    <Setter Property="Text" Value="{l:Loc Overlay_ApproveSign}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelectionOnly}" Value="True">
                    <Setter Property="Text" Value="{l:Loc Overlay_ApproveSelect}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                    <Setter Property="Text" Value="{l:Loc Overlay_Waiting}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid x:Name="RootGrid" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TranslateTransform />
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="NativeNCA"
                     ShowMinimize="False"
                     ShowMaximize="False"
                     CanMaximize="False">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="ShieldKeyhole24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="24,4,24,20">

                <!-- ============ Header: what & who ============ -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" CornerRadius="12" VerticalAlignment="Top"
                            Background="{DynamicResource AccentFillColorDefaultBrush}">
                        <ui:SymbolIcon FontSize="26" Filled="True" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}">
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Setter Property="Symbol" Value="Signature24" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAuthRequest}" Value="True">
                                            <Setter Property="Symbol" Value="PersonKey20" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelectionOnly}" Value="True">
                                            <Setter Property="Symbol" Value="Certificate24" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ActionDescription}" FontSize="20" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Margin="0,2,0,0" Text="{l:Loc Overlay_Subtitle}"
                                   Style="{StaticResource SecondaryText}" FontSize="13" />
                    </StackPanel>
                </Grid>

                <!-- ============ Origin card with security badge ============ -->
                <Border Padding="14,10" CornerRadius="8" BorderThickness="1"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:SymbolIcon Grid.Column="0" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center">
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Setter Property="Symbol" Value="LockClosed24" />
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSecureOrigin}" Value="False">
                                            <Setter Property="Symbol" Value="ShieldError24" />
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding OriginDomain}" FontSize="15" FontWeight="SemiBold"
                                       Style="{StaticResource PrimaryText}" ToolTip="{Binding OriginUrl}" />
                            <TextBlock Text="{Binding OriginUrl}" Style="{StaticResource TertiaryText}" />
                        </StackPanel>

                        <Border Grid.Column="2" Margin="10,0,0,0" CornerRadius="10" Padding="8,2,8,3" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSecureOrigin}" Value="False">
                                            <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock FontSize="11" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="HTTPS" />
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSecureOrigin}" Value="False">
                                                <Setter Property="Text" Value="{l:Loc Overlay_NotSecure}" />
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </Grid>
                </Border>

                <!-- ============ Data preview ============ -->
                <TextBlock Text="{l:Loc Overlay_RequestContent}" Margin="2,16,0,6" Style="{StaticResource SecondaryText}" />
                <Border CornerRadius="8" BorderThickness="1" Padding="12,8"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                    <ScrollViewer MaxHeight="84" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <TextBlock Text="{Binding DataPreview}" TextWrapping="Wrap"
                                   FontFamily="{StaticResource MonoFontFamily}" FontSize="12" LineHeight="18"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </ScrollViewer>
                </Border>

                <!-- ============ Key selector ============ -->
                <TextBlock Text="{l:Loc Overlay_Key}" Margin="2,16,0,6" Style="{StaticResource SecondaryText}" />

                <ListBox x:Name="KeysList"
                         ItemsSource="{Binding MatchingKeys}"
                         SelectedItem="{Binding SelectedKey}"
                         ItemTemplate="{StaticResource OverlayKeyTemplate}"
                         ItemContainerStyle="{StaticResource KeyRadioCardItem}"
                         Style="{StaticResource CardListBox}"
                         MaxHeight="232"
                         Visibility="{Binding HasKeys, Converter={StaticResource BoolToVisibility}}" />

                <ui:InfoBar Title="{l:Loc Overlay_NoKeysTitle}"
                            Message="{l:Loc Overlay_NoKeysMessage}"
                            Severity="Warning" IsClosable="False"
                            IsOpen="{Binding HasKeys, Converter={StaticResource InverseBool}}" />

                <!-- ============ Password ============ -->
                <StackPanel Margin="0,8,0,0"
                            Visibility="{Binding IsPasswordRequired, Converter={StaticResource BoolToVisibility}}">
                    <ui:PasswordBox x:Name="PasswordInput"
                                    Password="{Binding ManualPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="{l:Loc Common_KeyPassword}"
                                    Icon="{ui:SymbolIcon Password24}" />
                </StackPanel>

                <StackPanel Margin="2,8,0,0" Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsPasswordRequired}" Value="False" />
                                        <Condition Binding="{Binding HasKeys}" Value="True" />
                                        <Condition Binding="{Binding IsSelectionOnly}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <ui:SymbolIcon Symbol="ShieldCheckmark16" FontSize="14" Margin="0,0,6,0"
                                   Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                    <TextBlock Text="{l:Loc Overlay_PasswordFromVault}" Style="{StaticResource SecondaryText}" />
                </StackPanel>

                <!-- ============ Error ============ -->
                <ui:InfoBar Margin="0,12,0,0" Title="{l:Loc Overlay_ErrorTitle}"
                            Message="{Binding ErrorMessage}"
                            Severity="Error" IsClosable="False"
                            IsOpen="{Binding ErrorMessage, Converter={StaticResource NotEmptyToBool}}" />
            </StackPanel>
        </ScrollViewer>

        <!-- ============ Footer (ContentDialog-style command area) ============ -->
        <Border Grid.Row="2" Padding="24,16,24,20" BorderThickness="0,1,0,0"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ui:Button x:Name="ApproveButton" Grid.Column="0"
                           Appearance="Primary"
                           Command="{Binding ApproveCommand}"
                           IsDefault="True"
                           IsEnabled="{Binding HasKeys}"
                           HorizontalAlignment="Stretch"
                           Height="36">
                    <StackPanel Orientation="Horizontal">
                        <ui:ProgressRing Width="16" Height="16" Margin="0,0,10,0" IsIndeterminate="True"
                                         Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                         Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVisibility}}" />
                        <ui:SymbolIcon Style="{StaticResource ApproveIcon}" />
                        <TextBlock Style="{StaticResource ApproveText}" />
                    </StackPanel>
                </ui:Button>

                <ui:Button Grid.Column="2"
                           Content="{l:Loc Common_Cancel}"
                           Command="{Binding CancelCommand}"
                           IsCancel="True"
                           HorizontalAlignment="Stretch"
                           Height="36" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
