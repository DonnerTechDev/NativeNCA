<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:conv="clr-namespace:NativeNCA.App.Converters"
                    xmlns:l="clr-namespace:NativeNCA.App.Localization">

    <!-- ===================== Converters ===================== -->
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    <conv:NotEmptyToBoolConverter x:Key="NotEmptyToBool" />
    <conv:InverseBoolConverter x:Key="InverseBool" />
    <conv:ImagePathToSourceConverter x:Key="ImagePathToSource" />

    <FontFamily x:Key="MonoFontFamily">Cascadia Mono, Consolas, Courier New</FontFamily>

    <!-- ===================== Typography ===================== -->
    <Style x:Key="PageTitleText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="SectionHeaderText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="2,28,0,8" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="PrimaryText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="SecondaryText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="TertiaryText" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    </Style>

    <Style x:Key="FieldLabelText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <!-- ===================== Avatar & pills ===================== -->
    <Style x:Key="KeyAvatar" TargetType="Border">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
        <Setter Property="TextElement.FontWeight" Value="SemiBold" />
        <Setter Property="TextElement.FontSize" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="AvatarText" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
    </Style>

    <!--
        Key avatar: the user's picture if set, otherwise initials on an accent circle.
        Usage: <ContentControl Template="{StaticResource KeyAvatarView}" Width="40" Height="40" FontSize="14" />
        (DataContext = KeyItemViewModel; FontSize sets the initials size)
    -->
    <ControlTemplate x:Key="KeyAvatarView" TargetType="ContentControl">
        <Grid>
            <Ellipse Fill="{DynamicResource AccentFillColorDefaultBrush}" />
            <TextBlock x:Name="Initials" Text="{Binding Initials}" FontSize="{TemplateBinding FontSize}" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            <Ellipse x:Name="Photo" Visibility="Collapsed">
                <Ellipse.Fill>
                    <ImageBrush ImageSource="{Binding AvatarPath, Converter={StaticResource ImagePathToSource}}"
                                Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse x:Name="Ring" Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" StrokeThickness="1" Visibility="Collapsed" />
        </Grid>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding HasAvatar}" Value="True">
                <Setter TargetName="Photo" Property="Visibility" Value="Visible" />
                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                <Setter TargetName="Initials" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,2,8,3" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="PillText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--
        Status badge for a KeyItemViewModel: coloured dot + "Активен / Истекает через N дн. / Истёк".
        Usage: <ContentControl Template="{StaticResource KeyStatusBadge}" />  (DataContext = key)
    -->
    <ControlTemplate x:Key="KeyStatusBadge" TargetType="ContentControl">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse x:Name="Dot" Width="8" Height="8" Margin="0,1,6,0" VerticalAlignment="Center"
                     Fill="{DynamicResource SystemFillColorSuccessBrush}" />
            <TextBlock x:Name="Label" Text="{Binding StatusText}" FontSize="12" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsExpiringSoon}" Value="True">
                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsExpired}" Value="True">
                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Usage pill: "Подпись" / "Вход" with matching icon -->
    <ControlTemplate x:Key="KeyUsagePill" TargetType="ContentControl">
        <Border Style="{StaticResource Pill}">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon x:Name="Icon" Symbol="Signature20" FontSize="12" Margin="0,0,4,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="Label" Text="{Binding UsageText}" Style="{StaticResource PillText}" />
            </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsAuth}" Value="True">
                <Setter TargetName="Icon" Property="Symbol" Value="PersonKey20" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsAuthAndSign}" Value="True">
                <Setter TargetName="Icon" Property="Symbol" Value="Key24" />
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- "Пароль в Vault" pill, visible only when the password is stored -->
    <ControlTemplate x:Key="SavedPasswordPill" TargetType="ContentControl">
        <Border x:Name="Root" Style="{StaticResource Pill}" Visibility="Collapsed"
                ToolTip="{l:Loc Key_SavedPasswordPillTooltip}">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="LockClosed16" FontSize="12" Margin="0,0,4,0"
                               Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                <TextBlock Text="{l:Loc Key_SavedPasswordPill}" Style="{StaticResource PillText}" />
            </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsPasswordSaved}" Value="True">
                <Setter TargetName="Root" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- ===================== Card-like list items ===================== -->
    <Style x:Key="CardListBox" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer Padding="{TemplateBinding Padding}" Focusable="False">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Card list item with Win11-style hover/selection, like the NavigationView / Settings list:
        selection is a filled background plus the vertical accent "pill", no accent outline
        (an outline reads as keyboard focus). Radio cards (Tag=NoPill) use the accent outline instead.
    -->
    <Style x:Key="KeyCardItem" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Card" CornerRadius="8" BorderThickness="1"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" />
                        <Border x:Name="Hover" CornerRadius="8" Opacity="0"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        <Border x:Name="Selection" CornerRadius="8" Opacity="0" BorderThickness="0"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" />
                        <Border x:Name="Pill" Width="3" Height="18" CornerRadius="1.5" Margin="3,0,0,0"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleY="0" />
                            </Border.RenderTransform>
                        </Border>
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Selection" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="Pill" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.25">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Selection" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="Pill" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                        <Trigger Property="Tag" Value="NoPill">
                            <Setter TargetName="Pill" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Selection" Property="BorderThickness" Value="1" />
                            <Setter TargetName="Selection" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Same card, used as a radio option (the template draws its own radio indicator) -->
    <Style x:Key="KeyRadioCardItem" TargetType="ListBoxItem" BasedOn="{StaticResource KeyCardItem}">
        <Setter Property="Tag" Value="NoPill" />
    </Style>

    <!-- ===================== Settings-style rows ===================== -->
    <Style x:Key="SettingsCard" TargetType="ui:CardControl" BasedOn="{StaticResource {x:Type ui:CardControl}}">
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="MinHeight" Value="68" />
    </Style>

    <Style x:Key="SettingsTitleText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SettingsDescriptionText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Label / value rows inside the certificate card -->
    <Style x:Key="DetailLabelText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="DetailValueText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <!-- One "label | value | action" row in a details card -->
    <Style x:Key="DetailRow" TargetType="Grid">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Margin" Value="0,1" />
    </Style>

    <Style x:Key="RowDivider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="-16,0" />
        <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
    </Style>

    <!-- Small borderless icon button (copy etc.) -->
    <Style x:Key="IconButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Appearance" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
