<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\NativeNCA.Core\NativeNCA.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="WPF-UI.Tray" Version="4.3.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <AssemblyName>NativeNCA</AssemblyName>
    <RootNamespace>NativeNCA.App</RootNamespace>
    <AssemblyTitle>NativeNCA</AssemblyTitle>
    <Product>NativeNCA</Product>
    <!-- CI passes -p:Version from the release tag; the updater compares the informational version. -->
    <Version>0.0.0-dev</Version>
    <!-- Setup and the updater copy only NativeNCA.exe: WPF's native DLLs must be inside it. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets/app.ico" />
  </ItemGroup>

</Project>
